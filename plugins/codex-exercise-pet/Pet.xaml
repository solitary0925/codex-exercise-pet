<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 伸展兔" Width="348" Height="285"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#EDF6F1"/>
      <Setter Property="Background" Value="#324A42"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Scene" Margin="12,0,12,16">
    <Grid.RenderTransform><TranslateTransform x:Name="EntryOffset"/></Grid.RenderTransform>
    <Border Margin="0,84,0,0" CornerRadius="19" Background="#20362F"
            BorderBrush="#4D7063" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="17" Opacity="0.25" ShadowDepth="4"/></Border.Effect>
      <Grid Margin="18,13,18,13">
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Border x:Name="Header" Grid.Row="0" Background="Transparent" Cursor="SizeAll">
          <TextBlock Text="伸展兔" Foreground="#AFD2C3" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,3,0,0">
          <TextBlock x:Name="Heading" Foreground="#F4FAF6" FontWeight="Bold" FontSize="20"/>
          <TextBlock x:Name="Detail" Foreground="#D1E6DC" FontSize="13" Margin="0,6,0,0"
                     TextWrapping="Wrap" LineHeight="20"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="MainButton" HorizontalAlignment="Left" MinWidth="91"
                  Background="#BDF4D7" Foreground="#16382B" FontWeight="Bold" Content="开始"/>
          <TextBlock x:Name="Countdown" Visibility="Collapsed" VerticalAlignment="Center"
                     Foreground="#BDF4D7" FontFamily="Consolas" FontSize="24" FontWeight="Bold"/>
          <Button x:Name="DismissButton" Grid.Column="1" Content="跳过" MinWidth="60"/>
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="PetHandle" Background="Transparent" Cursor="SizeAll" Width="116" Height="111"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,14,0">
      <Canvas Width="112" Height="108" IsHitTestVisible="False">
        <Path Fill="#FFE4A0" Data="M90,20 L93,27 L100,30 L93,33 L90,40 L87,33 L80,30 L87,27 Z"/>
        <Ellipse Canvas.Left="101" Canvas.Top="44" Width="5" Height="5" Fill="#FFE4A0"/>
        <Path Fill="#ADE9C9" Stroke="#284D3F" StrokeThickness="2"
              Data="M30,52 C23,37 16,13 26,8 C35,3 43,25 45,44 C48,27 54,7 64,11 C73,15 66,41 61,52 Z"/>
        <Path Fill="#F2BAA9" Data="M33,43 C28,33 23,16 27,15 C31,15 37,32 37,42 Z M52,43 C55,30 60,17 63,18 C66,20 60,37 57,45 Z"/>
        <Path Fill="#C7F6DC" Stroke="#284D3F" StrokeThickness="2"
              Data="M19,76 C19,54 31,43 49,43 C68,43 83,55 83,74 C83,91 68,100 49,100 C30,100 19,93 19,76 Z"/>
        <Ellipse Canvas.Left="26" Canvas.Top="75" Width="11" Height="6" Fill="#F3BBAA"/>
        <Ellipse Canvas.Left="63" Canvas.Top="75" Width="11" Height="6" Fill="#F3BBAA"/>
        <Ellipse Canvas.Left="35" Canvas.Top="66" Width="5" Height="7" Fill="#284D3F"/>
        <Ellipse Canvas.Left="60" Canvas.Top="66" Width="5" Height="7" Fill="#284D3F"/>
        <Path Stroke="#284D3F" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M45,77 Q48,81 50,77 Q53,81 56,77"/>
        <Ellipse Canvas.Left="22" Canvas.Top="89" Width="18" Height="15" Fill="#ABE9C9" Stroke="#284D3F" StrokeThickness="2"/>
        <Ellipse Canvas.Left="62" Canvas.Top="89" Width="18" Height="15" Fill="#ABE9C9" Stroke="#284D3F" StrokeThickness="2"/>
      </Canvas>
    </Border>
  </Grid>
</Window>
